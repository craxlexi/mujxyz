[Unit]
Description=MUJ Pulse API
After=network-online.target
Wants=network-online.target

[Service]
User=pulse
Group=pulse
WorkingDirectory=/opt/muj-pulse/backend
EnvironmentFile=/opt/muj-pulse/backend/.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/opt/muj-pulse/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/muj-pulse/backend/data
MemoryMax=256M

[Install]
WantedBy=multi-user.target
