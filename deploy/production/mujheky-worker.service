[Unit]
Description=MUJheky polling and push worker
After=network-online.target mujheky-api.service
Wants=network-online.target

[Service]
User=mujheky
Group=mujheky
WorkingDirectory=/opt/mujheky/backend
EnvironmentFile=/opt/mujheky/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/opt/mujheky/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mujheky/backend/data
MemoryMax=256M

[Install]
WantedBy=multi-user.target
