[Unit]
Description=MUJheky API
After=network-online.target
Wants=network-online.target

[Service]
User=mujheky
Group=mujheky
WorkingDirectory=/opt/mujheky/backend
EnvironmentFile=/opt/mujheky/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/opt/mujheky/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mujheky/backend/data
MemoryMax=256M

[Install]
WantedBy=multi-user.target
